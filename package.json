{
  "name": "vs-instituto",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:site": "pnpm --filter @workspace/vs-instituto run dev",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "build": "pnpm --filter @workspace/vs-instituto run build && pnpm --filter @workspace/api-server run build",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "codegen": "pnpm --filter @workspace/api-spec run codegen"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.9"
  }
}
